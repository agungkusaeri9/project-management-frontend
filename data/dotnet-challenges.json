      "id": "ch-financial-idempotent-payment",
      "title": "Idempotent Payment API",
      "category": "financial",
      "categoryLabel": "Banking & Financial Systems",
      "difficulty": "MEDIUM",
      "severity": "CRITICAL",
      "description": "Build a payment API that safely handles duplicate requests without charging the customer multiple times.",
      "scenario": "A mobile client sends a payment request, but the network times out. The client retries the same request several times. The system must process the payment only once.",
      "requirements": [
        "Accept an idempotency key from the client.",
        "Store the result associated with the idempotency key.",
        "Return the original result when the same request is retried.",
        "Prevent concurrent duplicate processing.",
        "Handle requests arriving on multiple application instances."
      ],
      "technologies": [
        ".NET",
        "ASP.NET Core",
        "SQL",
        "Redis",
        "Distributed Lock"
      ],
      "concepts": [
        "Idempotency",
        "Concurrency",
        "Distributed Systems",
        "Transactions"
      ],
      "successCriteria": [
        "The same payment request cannot create multiple transactions.",
        "Concurrent requests with the same idempotency key are handled safely.",
        "The solution works across multiple API instances."
      ],
      "tags": ["Banking", "Payment", "Idempotency", "Concurrency"]
    },
