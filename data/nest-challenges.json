    {
      "id": "ch-nestjs-idempotent-payment",
      "title": "Idempotent Payment API",
      "category": "financial",
      "categoryLabel": "Banking & Financial Systems",
      "difficulty": "HARD",
      "severity": "CRITICAL",
      "description": "Build a payment API using NestJS that safely handles duplicate requests without creating duplicate financial transactions.",
      "scenario": "A client sends a payment request but does not receive the response because of a network timeout. The client retries the request multiple times.",
      "requirements": [
        "Accept an Idempotency-Key header.",
        "Persist the idempotency key and transaction result.",
        "Return the original result for duplicate requests.",
        "Prevent concurrent requests with the same idempotency key.",
        "Support multiple NestJS application instances."
      ],
      "technologies": ["NestJS", "TypeScript", "PostgreSQL", "Redis"],
      "concepts": [
        "Idempotency",
        "Concurrency",
        "Database Transactions",
        "Distributed Lock"
      ],
      "successCriteria": [
        "One payment request produces exactly one financial transaction.",
        "Concurrent duplicate requests are handled safely.",
        "The solution works across multiple API instances."
      ],
      "tags": ["Banking", "Payment", "Idempotency", "Concurrency"]
    },
